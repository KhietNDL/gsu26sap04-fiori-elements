{
  "_version": "1.59.0",
  "sap.app": {
    "id": "ztbl.config.ui",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zsb_tbl_config/srvd/sap/zsd_tbl_config/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml",
          "annotations": [
            "tableConfigAnnotation",
            "fieldConfigAnnotation",
            "approvalRequestAnnotation",
            "auditLogAnnotation"
          ]
        }
      },
      "tableConfigAnnotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/table-config.xml",
        "settings": {
          "localUri": "annotations/table-config.xml"
        }
      },
      "fieldConfigAnnotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/field-config.xml",
        "settings": {
          "localUri": "annotations/field-config.xml"
        }
      },
      "approvalRequestAnnotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/approval-request.xml",
        "settings": {
          "localUri": "annotations/approval-request.xml"
        }
      },
      "auditLogAnnotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/audit-log.xml",
        "settings": {
          "localUri": "annotations/audit-log.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZTableConfig-manage": {
          "semanticObject": "ZTableConfig",
          "action": "manage",
          "title": "{{flpTitle}}",
          "subtitle": "{{flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        },
        "ZApprovalRequest-manage": {
          "semanticObject": "ZApprovalRequest",
          "action": "manage",
          "title": "{{approvalInboxFlpTitle}}",
          "subtitle": "{{approvalInboxFlpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        },
        "ZAuditLog-display": {
          "semanticObject": "ZAuditLog",
          "action": "display",
          "title": "{{auditLogFlpTitle}}",
          "subtitle": "{{auditLogFlpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "icons": {
      "icon": "sap-icon://table-view"
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.108.24",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ztbl.config.ui.i18n.i18n"
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "TableConfigList",
          "target": "TableConfigList"
        },
        {
          "pattern": "TableConfig({key}):?query:",
          "name": "TableConfigObjectPage",
          "target": "TableConfigObjectPage"
        },
        {
          "pattern": "ApprovalRequest:?query:",
          "name": "ApprovalRequestList",
          "target": "ApprovalRequestList"
        },
        {
          "pattern": "ApprovalRequest({key}):?query:",
          "name": "ApprovalRequestObjectPage",
          "target": "ApprovalRequestObjectPage"
        },
        {
          "pattern": "AuditLog:?query:",
          "name": "AuditLogList",
          "target": "AuditLogList"
        },
        {
          "pattern": "AuditLog({key}):?query:",
          "name": "AuditLogObjectPage",
          "target": "AuditLogObjectPage"
        }
      ],
      "targets": {
        "TableConfigList": {
          "type": "Component",
          "id": "TableConfigList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/TableConfig",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "TableConfig": {
                  "detail": {
                    "route": "TableConfigObjectPage"
                  }
                }
              }
            }
          }
        },
        "TableConfigObjectPage": {
          "type": "Component",
          "id": "TableConfigObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/TableConfig",
              "editableHeaderContent": false,
              "content": {
                "body": {
                  "sections": {}
                }
              }
            }
          }
        },
        "ApprovalRequestList": {
          "type": "Component",
          "id": "ApprovalRequestList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ApprovalRequest",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "ApprovalRequest": {
                  "detail": {
                    "route": "ApprovalRequestObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "ApprovalRequestObjectPage": {
          "type": "Component",
          "id": "ApprovalRequestObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ApprovalRequest",
              "editableHeaderContent": false
            }
          }
        },
        "AuditLogList": {
          "type": "Component",
          "id": "AuditLogList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/AuditLog",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "AuditLog": {
                  "detail": {
                    "route": "AuditLogObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "AuditLogObjectPage": {
          "type": "Component",
          "id": "AuditLogObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/AuditLog",
              "editableHeaderContent": false
            }
          }
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "ztbl.config.ui"
  }
}
