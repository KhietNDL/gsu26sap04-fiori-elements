{
  "name": "ztbl-config-ui",
  "version": "1.0.0",
  "private": true,
  "description": "SAP Fiori Elements - Table & Field Configuration Management",
  "scripts": {
    "start": "npm run start:table",
    "start:flp": "npm run start:table",
    "start:local": "npm run start:table",
    "start:table": "fiori run --config ui5.yaml --open \"test/flpSandbox.html?sap-client=324&fiori-tools-iapp-state=true#ZTableConfig-manage\"",
    "start:approval": "fiori run --config ui5-approval.yaml --open \"test/flpSandbox.html?sap-client=324&fiori-tools-iapp-state=true#ZApprovalRequest-manage\"",
    "start:audit": "fiori run --config ui5-audit.yaml --open \"test/flpSandbox.html?sap-client=324&fiori-tools-iapp-state=true#ZAuditLog-display\"",
    "build": "npm run build:table",
    "build:table": "ui5 build preload --clean-dest --config ui5.yaml --dest dist/table-config",
    "build:approval": "ui5 build preload --clean-dest --config ui5-approval.yaml --dest dist/approval-request",
    "build:audit": "ui5 build preload --clean-dest --config ui5-audit.yaml --dest dist/audit-log",
    "build:all": "npm run build:table && npm run build:approval && npm run build:audit",
    "deploy": "npm run deploy:table",
    "deploy:table": "fiori deploy --config ui5-deploy.yaml --yes",
    "deploy:approval": "fiori deploy --config ui5-deploy-approval.yaml --yes",
    "deploy:audit": "fiori deploy --config ui5-deploy-audit.yaml --yes",
    "build:deploy": "npm run build:table && npm run deploy:table",
    "build:deploy:approval": "npm run build:approval && npm run deploy:approval",
    "build:deploy:audit": "npm run build:audit && npm run deploy:audit"
  },
  "devDependencies": {
    "@sap-ux/ui5-middleware-fe-mockserver": "^2.4.13",
    "@sap/ux-specification": "latest",
    "@sap/ux-ui5-tooling": "latest",
    "@ui5/cli": "latest"
  }
}
