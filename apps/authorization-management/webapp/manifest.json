{
  "_version": "1.59.0",
  "sap.app": {
    "id": "ztbl.authorization.ui",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "crossNavigation": {
      "inbounds": {
        "ZAuthorizationManagement-manage": {
          "semanticObject": "ZAuthorizationManagement",
          "action": "manage",
          "title": "{{authorizationFlpTitle}}",
          "subtitle": "{{authorizationFlpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "icons": {
      "icon": "sap-icon://permission"
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.108.33",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ushell": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ztbl.authorization.ui.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/authorization.css"
        }
      ]
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "ztbl.authorization.ui"
  }
}
