{
  "_version": "1.59.0",
  "sap.app": {
    "id": "ztbl.authorization.users.ui",
    "type": "application",
    "title": "Users",
    "description": "Manage system users, roles, and active status.",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZSB_AUTH_ADMIN_V2/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "annotations": [
            "authorizationAnnotation"
          ]
        }
      },
      "authorizationAnnotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/users.xml",
        "settings": {
          "localUri": "annotations/users.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "icons": {
      "icon": "sap-icon://permission"
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.108.33",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.suite.ui.generic.template": {}
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.viewExtensions": {
          "sap.suite.ui.generic.template.ListReport.view.ListReport": {
            "ResponsiveTableColumnsExtension|AuthUsers": {
              "className": "sap.ui.core.Fragment",
              "fragmentName": "ztbl.authorization.ui.ext.fragment.ActiveStatusColumn",
              "type": "XML"
            },
            "ResponsiveTableCellsExtension|AuthUsers": {
              "className": "sap.ui.core.Fragment",
              "fragmentName": "ztbl.authorization.ui.ext.fragment.ActiveStatusCell",
              "type": "XML"
            }
          }
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "../css/authorization.css"
        }
      ]
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "type": "sap.ui.model.odata.v2.ODataModel",
        "settings": {
          "useBatch": true,
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "refreshAfterChange": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.ui.generic.app": {
    "_version": "1.3.0",
    "settings": {
      "forceGlobalRefresh": false,
      "objectPageHeaderType": "Dynamic",
      "showDraftToggle": false
    },
    "pages": {
      "ListReport|AuthUsers": {
        "entitySet": "AuthUsers",
        "component": {
          "name": "sap.suite.ui.generic.template.ListReport",
          "list": true,
          "settings": {
            "smartVariantManagement": true,
            "condensedTableLayout": true,
            "enableTableFilterInPageVariant": true,
            "dataLoadSettings": {
              "loadDataOnAppLaunch": "always"
            },
            "tableType": "ResponsiveTable"
          }
        },
        "pages": {
          "ObjectPage|AuthUsers": {
            "entitySet": "AuthUsers",
            "component": {
              "name": "sap.suite.ui.generic.template.ObjectPage",
              "settings": {
                "editableHeaderContent": false
              }
            }
          }
        }
      }
    }
  }
}
