<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <VBox
    width="100%"
    class="sapUiSmallMarginTop approvalRequestDetail approvalBusinessChange"
    visible="{= !${approvalDetail>/bulkVisible} }">
    <Title
      text="{approvalDetail>/changeTitle}"
      level="H3"
      class="sapUiTinyMarginBottom"/>

    <MessageStrip
      type="Information"
      showIcon="true"
      text="{approvalDetail>/changeMessage}"
      class="sapUiSmallMarginBottom"/>

    <Panel
      expandable="true"
      expanded="true"
      headerText="Record Key"
      class="approvalObjectKeyPanel sapUiSmallMarginBottom"
      visible="{approvalDetail>/recordKeyVisible}">
      <Table
        width="100%"
        fixedLayout="false"
        showNoData="false"
        items="{approvalDetail>/recordKeyRows}">
        <columns>
          <Column width="16rem">
            <Text text="Field"/>
          </Column>
          <Column>
            <Text text="Value"/>
          </Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <ObjectIdentifier
                title="{approvalDetail>field}"
                class="approvalFieldName"/>
              <Text
                text="{approvalDetail>value}"
                wrapping="true"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </Panel>

    <Table
      width="100%"
      class="approvalChangeSapTable"
      fixedLayout="false"
      showNoData="true"
      noDataText="No business field changes available"
      items="{approvalDetail>/changeRows}">
      <columns>
        <Column width="16rem">
          <Text text="Field"/>
        </Column>
        <Column visible="{approvalDetail>/showOldColumn}">
          <Text text="{approvalDetail>/oldColumnHeader}"/>
        </Column>
        <Column visible="{approvalDetail>/showNewColumn}">
          <Text text="{approvalDetail>/newColumnHeader}"/>
        </Column>
      </columns>
      <items>
        <ColumnListItem>
          <cells>
            <ObjectIdentifier
              title="{approvalDetail>field}"
              class="approvalFieldName"/>
            <Text
              text="{approvalDetail>oldValue}"
              wrapping="true"
              visible="{approvalDetail>/showOldColumn}"/>
            <Text
              text="{approvalDetail>newValue}"
              wrapping="true"
              visible="{approvalDetail>/showNewColumn}"/>
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>
</core:FragmentDefinition>
