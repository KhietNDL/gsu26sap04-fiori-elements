<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <VBox
    width="100%"
    class="sapUiSmallMarginTop approvalRequestDetail approvalBusinessChange"
    visible="{= !${approvalDetail>/bulkVisible} }">
    <Title
      text="{approvalDetail>/changeTitle}"
      level="H3"
      class="sapUiTinyMarginBottom"/>

    <core:HTML
      content="{approvalDetail>/changeTableHtml}"
      sanitizeContent="false"
      visible="{= !!${approvalDetail>/changeTableHtml} }"/>
    <MessageStrip
      type="Information"
      showIcon="true"
      text="No business field changes available"
      visible="{= !${approvalDetail>/changeTableHtml} }"/>
  </VBox>
</core:FragmentDefinition>
