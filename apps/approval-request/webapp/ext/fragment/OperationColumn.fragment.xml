<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <ObjectStatus
    class="approvalListCellText approvalOperationBadge"
    text="{parts: [{path: 'ActionType'}, {path: 'RecordKey'}], formatter: 'ztbl.approval.ui.ext.formatter.ApprovalFormatter.formatRequestActionText'}"
    state="{parts: [{path: 'ActionType'}, {path: 'RecordKey'}], formatter: 'ztbl.approval.ui.ext.formatter.ApprovalFormatter.formatRequestActionState'}">
    <customData>
      <core:CustomData
        key="action"
        value="{parts: [{path: 'ActionType'}, {path: 'RecordKey'}], formatter: 'ztbl.approval.ui.ext.formatter.ApprovalFormatter.formatRequestActionKey'}"
        writeToDom="true"/>
    </customData>
  </ObjectStatus>
</core:FragmentDefinition>
