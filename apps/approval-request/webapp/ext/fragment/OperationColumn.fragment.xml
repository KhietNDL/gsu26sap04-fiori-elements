<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  core:require="{formatter: 'ztbl/approval/ui/ext/formatter/ApprovalFormatter'}">
  <ObjectStatus
    class="approvalListCellText approvalOperationBadge"
    text="{parts: [{path: 'ActionType'}, {path: 'RecordKey'}], formatter: 'formatter.formatRequestActionText'}"
    state="None">
    <customData>
      <core:CustomData
        key="action"
        value="{parts: [{path: 'ActionType'}, {path: 'RecordKey'}], formatter: 'formatter.formatRequestActionKey'}"
        writeToDom="true"/>
    </customData>
  </ObjectStatus>
</core:FragmentDefinition>
