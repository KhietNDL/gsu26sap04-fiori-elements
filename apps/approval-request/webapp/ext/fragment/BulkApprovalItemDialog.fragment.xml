<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Dialog
    title="Approval Item"
    contentWidth="64rem"
    contentHeight="80%"
    stretchOnPhone="true"
    resizable="true"
    draggable="true"
    class="approvalBulkItemDialog">
    <content>
      <VBox
        width="100%"
        class="approvalBulkItemDialogContent">
        <VBox
          width="100%"
          class="approvalItemDialogHeader sapUiSmallMarginBottom">
          <FlexBox
            width="100%"
            wrap="Wrap"
            class="approvalItemHeaderGrid">
            <VBox class="approvalItemHeaderCell">
              <Label text="Item Number"/>
              <Text
                text="{approvalDetail>/bulkItemNumberText}"
                wrapping="true"/>
            </VBox>
            <VBox class="approvalItemHeaderCell">
              <Label text="Action Type"/>
              <ObjectStatus
                text="{approvalDetail>/bulkItemActionText}"
                state="{approvalDetail>/bulkItemActionState}"/>
            </VBox>
            <VBox class="approvalItemHeaderCell">
              <Label text="Status"/>
              <ObjectStatus
                text="{approvalDetail>/bulkItemStatusText}"
                state="{approvalDetail>/bulkItemStatusState}"/>
            </VBox>
          </FlexBox>
          <VBox class="approvalItemRecordKeySummary">
            <Label text="Record Key"/>
            <Text
              text="{approvalDetail>/bulkItemRecordKeyText}"
              wrapping="true"
              class="approvalItemRecordKeyText"/>
          </VBox>
        </VBox>

        <Title
          text="Record Key"
          level="H4"
          class="sapUiTinyMarginBottom"/>
        <Table
          width="100%"
          fixedLayout="true"
          showNoData="true"
          noDataText="No parsed record key fields available"
          class="approvalChangeSapTable sapUiSmallMarginBottom"
          items="{approvalDetail>/bulkItemRecordKeyRows}">
          <columns>
            <Column width="16rem">
              <Text text="Field"/>
            </Column>
            <Column>
              <Text text="Value"/>
            </Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <ObjectIdentifier
                  title="{approvalDetail>field}"
                  class="approvalFieldName"/>
                <Text
                  text="{approvalDetail>value}"
                  wrapping="true"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <Toolbar
          design="Transparent"
          class="approvalBulkItemDialogToolbar">
          <Title
            text="{approvalDetail>/bulkItemTitle}"
            level="H4"/>
          <ToolbarSpacer/>
          <CheckBox
            text="Show all fields"
            selected="{approvalDetail>/bulkItemShowAllFields}"
            visible="{approvalDetail>/bulkItemShowAllFieldsVisible}"
            select=".onBulkItemShowAllFieldsChange"/>
        </Toolbar>

        <MessageStrip
          type="Information"
          showIcon="true"
          text="{approvalDetail>/bulkItemMessage}"
          class="sapUiTinyMarginBottom"/>

        <Table
          width="100%"
          class="approvalChangeSapTable"
          fixedLayout="true"
          showNoData="true"
          noDataText="No business field changes available"
          items="{approvalDetail>/bulkItemRows}">
          <columns>
            <Column width="16rem">
              <Text text="Field"/>
            </Column>
            <Column visible="{approvalDetail>/bulkItemShowOldColumn}">
              <Text text="{approvalDetail>/bulkItemOldColumnHeader}"/>
            </Column>
            <Column visible="{approvalDetail>/bulkItemShowNewColumn}">
              <Text text="{approvalDetail>/bulkItemNewColumnHeader}"/>
            </Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <ObjectIdentifier
                  title="{approvalDetail>field}"
                  class="approvalFieldName"/>
                <Text
                  text="{approvalDetail>oldValue}"
                  wrapping="true"
                  visible="{approvalDetail>/bulkItemShowOldColumn}"/>
                <Text
                  text="{approvalDetail>newValue}"
                  wrapping="true"
                  visible="{approvalDetail>/bulkItemShowNewColumn}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>

      </VBox>
    </content>
    <beginButton>
      <Button
        text="Close"/>
    </beginButton>
  </Dialog>
</core:FragmentDefinition>
