<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  core:require="{formatter: 'ztbl/approval/ui/ext/formatter/ApprovalFormatter'}">
  <Text
    wrapping="true"
    maxLines="2"
    class="approvalListCellText approvalListCellText--summary"
    text="{
      parts: [
        {path: 'ActionType'},
        {path: 'RecordKey'},
        {path: 'OldData'},
        {path: 'NewData'}
      ],
      formatter: 'formatter.formatSummaryText'
    }"/>
</core:FragmentDefinition>
