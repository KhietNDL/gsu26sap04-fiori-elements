<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  core:require="{formatter: 'ztbl/approval/ui/ext/formatter/ApprovalFormatter'}">
  <VBox
    width="100%"
    class="sapUiSmallMarginTop approvalBulkItems approvalBusinessChange"
    visible="{approvalDetail>/bulkVisible}">
    <Title
      text="Approval Items"
      level="H3"
      class="sapUiTinyMarginBottom"/>

    <MessageStrip
      type="Information"
      showIcon="true"
      text="Approve and Reject remain request-level decisions. Review each item before processing the bulk request."
      class="sapUiSmallMarginBottom"/>

    <Text
      text="Loading approval items..."
      visible="{approvalDetail>/itemsLoading}"
      class="approvalBulkSummary sapUiTinyMarginBottom"/>

    <MessageStrip
      type="Error"
      showIcon="true"
      text="{approvalDetail>/itemsErrorText}"
      visible="{approvalDetail>/itemsErrorVisible}"
      class="sapUiSmallMarginBottom"/>

    <Text
      text="{approvalDetail>/bulkSummaryText}"
      visible="{approvalDetail>/bulkSummaryVisible}"
      class="approvalBulkSummary sapUiTinyMarginBottom"/>

    <Text
      text="No approval items found."
      visible="{approvalDetail>/itemsEmptyVisible}"
      class="approvalBulkSummary sapUiTinyMarginBottom"/>

    <Table
      id="approvalBulkItemsTable"
      width="100%"
      class="approvalBulkItemsTable"
      fixedLayout="false"
      growing="true"
      growingScrollToLoad="true"
      busy="{approvalDetail>/itemsLoading}"
      busyIndicatorDelay="0"
      noDataText="No approval items found."
      items="{path: 'approvalDetail>/bulkItems'}">
      <columns>
        <Column width="6rem">
          <Text text="ItemNo"/>
        </Column>
        <Column width="8rem">
          <Text text="ActionType"/>
        </Column>
        <Column minScreenWidth="Tablet" demandPopin="true">
          <Text text="RecordKey"/>
        </Column>
        <Column width="8rem">
          <Text text="Status"/>
        </Column>
        <Column width="9rem" hAlign="End">
          <Text text="View Changes"/>
        </Column>
      </columns>
      <items>
        <ColumnListItem>
          <cells>
            <Text
              text="{approvalDetail>ItemNo}"
              wrapping="true"/>
            <ObjectStatus
              text="{= ${approvalDetail>ActionType} === 'C' || ${approvalDetail>ActionType} === 'CREATE' || ${approvalDetail>ActionType} === '01' ? 'Create' : ${approvalDetail>ActionType} === 'U' || ${approvalDetail>ActionType} === 'UPDATE' || ${approvalDetail>ActionType} === '02' ? 'Update' : ${approvalDetail>ActionType} === 'D' || ${approvalDetail>ActionType} === 'DELETE' || ${approvalDetail>ActionType} === '03' ? 'Delete' : ${approvalDetail>ActionType} }"
              state="{= ${approvalDetail>ActionType} === 'C' || ${approvalDetail>ActionType} === 'CREATE' || ${approvalDetail>ActionType} === '01' ? 'Success' : ${approvalDetail>ActionType} === 'D' || ${approvalDetail>ActionType} === 'DELETE' || ${approvalDetail>ActionType} === '03' ? 'Error' : 'Information' }"/>
            <Text
              text="{path: 'approvalDetail>RecordKey', formatter: '.extension.ztbl.approval.ui.ext.controller.ApprovalListReport.formatBulkRecordKeyText'}"
              wrapping="true"/>
            <ObjectStatus
              text="{= ${approvalDetail>Status} === 'A' || ${approvalDetail>Status} === 'APPROVED' ? 'Approved' : ${approvalDetail>Status} === 'P' || ${approvalDetail>Status} === 'PENDING' ? 'Pending' : ${approvalDetail>Status} === 'R' || ${approvalDetail>Status} === 'REJECTED' ? 'Rejected' : ${approvalDetail>Status} }"
              state="{= ${approvalDetail>Status} === 'A' || ${approvalDetail>Status} === 'APPROVED' ? 'Success' : ${approvalDetail>Status} === 'R' || ${approvalDetail>Status} === 'REJECTED' || ${approvalDetail>Status} === 'E' || ${approvalDetail>Status} === 'ERROR' ? 'Error' : ${approvalDetail>Status} === 'P' || ${approvalDetail>Status} === 'PENDING' ? 'Warning' : 'Information' }"/>
            <Button
              text="View Changes"
              icon="sap-icon://display"
              type="Transparent"
              tooltip="View parsed item changes"
              class="viewChangesButton"
              press=".extension.ztbl.approval.ui.ext.controller.ApprovalListReport.onBulkItemPress"/>
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>
</core:FragmentDefinition>
