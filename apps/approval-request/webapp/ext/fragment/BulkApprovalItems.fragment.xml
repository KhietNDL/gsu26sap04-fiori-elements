<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  core:require="{formatter: 'ztbl/approval/ui/ext/formatter/ApprovalFormatter'}">
  <VBox
    width="100%"
    class="approvalBulkItems approvalBusinessChange"
    visible="{approvalDetail>/bulkVisible}">
    <Text
      text="Loading approval items..."
      visible="{approvalDetail>/itemsLoading}"
      class="approvalBulkSummary sapUiTinyMarginBottom"/>

    <MessageStrip
      type="Error"
      showIcon="true"
      text="{approvalDetail>/itemsErrorText}"
      visible="{approvalDetail>/itemsErrorVisible}"
      class="sapUiSmallMarginBottom"/>

    <Text
      text="No approval items found."
      visible="{approvalDetail>/itemsEmptyVisible}"
      class="approvalBulkSummary sapUiTinyMarginBottom"/>

    <ScrollContainer
      width="100%"
      horizontal="true"
      vertical="false"
      focusable="true"
      class="approvalItemsScrollContainer">
      <Table
        id="approvalBulkItemsTable"
        width="{approvalDetail>/bulkTableWidth}"
        fixedLayout="true"
        sticky="ColumnHeaders"
        growing="true"
        growingScrollToLoad="true"
        busy="{approvalDetail>/itemsLoading}"
        busyIndicatorDelay="0"
        noDataText="No approval items found."
        alternateRowColors="true"
        columns="{path: 'approvalDetail>/bulkColumns', templateShareable: false}"
        items="{path: 'approvalDetail>/bulkTableRows', templateShareable: false}"
        class="approvalBulkItemsTable approvalItemsSpreadsheet">
      <columns>
        <Column width="{approvalDetail>width}">
          <Text text="{approvalDetail>label}" tooltip="{approvalDetail>label}" class="approvalItemsHeaderText"/>
        </Column>
      </columns>
      <items>
        <ColumnListItem
          vAlign="Middle"
          cells="{path: 'approvalDetail>cells', templateShareable: false}"
          class="approvalItemsRow">
          <customData>
            <core:CustomData key="action" value="{approvalDetail>actionKey}" writeToDom="true"/>
          </customData>
          <cells>
            <VBox renderType="Bare" class="approvalSpreadsheetCell">
              <customData>
                <core:CustomData key="approvalField" value="{approvalDetail>field}" writeToDom="true"/>
              </customData>
              <ObjectStatus
                text="{approvalDetail>text}"
                state="{approvalDetail>state}"
                visible="{= ${approvalDetail>kind} === 'status' }"
                class="approvalSpreadsheetAction"/>
              <Text
                text="{approvalDetail>text}"
                tooltip="{approvalDetail>tooltip}"
                wrapping="true"
                visible="{= ${approvalDetail>kind} === 'key' }"
                class="approvalSpreadsheetKey"/>
              <Text
                text="{approvalDetail>text}"
                tooltip="{approvalDetail>tooltip}"
                wrapping="true"
                visible="{= ${approvalDetail>kind} !== 'status' &amp;&amp; ${approvalDetail>kind} !== 'key' }"
                class="approvalSpreadsheetText"/>
            </VBox>
          </cells>
        </ColumnListItem>
      </items>
      </Table>
    </ScrollContainer>
  </VBox>
</core:FragmentDefinition>
