<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <VBox width="100%" class="sapUiSmallMarginTop approvalOverview">
    <Toolbar design="Transparent">
      <Title text="Request Information" level="H3"/>
      <ToolbarSpacer/>
    </Toolbar>

    <List
      width="100%"
      showSeparators="Inner"
      items="{approvalDetail>/requestInfoRows}"
      class="approvalInfoList">
      <CustomListItem>
        <HBox
          width="100%"
          renderType="Bare"
          class="approvalInfoRow">
          <Label
            width="10rem"
            text="{approvalDetail>label}"
            class="approvalInfoLabel"/>
          <ObjectStatus
            visible="{approvalDetail>isStatus}"
            text="{approvalDetail>value}"
            state="{approvalDetail>state}"/>
          <Text
            visible="{= !${approvalDetail>isStatus} }"
            text="{approvalDetail>value}"
            wrapping="true"/>
        </HBox>
      </CustomListItem>
    </List>

    <Panel
      expandable="false"
      headerText="Approval Comment"
      class="sapUiSmallMarginTop approvalCommentPanel">
      <VBox class="approvalCommentContent">
        <Text
          text="{approvalDetail>/comment}"
          wrapping="true"
          class="approvalCommentText"/>
      </VBox>
    </Panel>

    <Panel
      expandable="true"
      expanded="false"
      headerText="Approval Comment Debug"
      class="sapUiSmallMarginTop"
      visible="{approvalDetail>/commentDebugVisible}">
      <Table
        width="100%"
        fixedLayout="false"
        showNoData="false"
        items="{approvalDetail>/commentDebugRows}">
        <columns>
          <Column width="16rem">
            <Text text="Field"/>
          </Column>
          <Column>
            <Text text="Value"/>
          </Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Text text="{approvalDetail>field}"/>
              <Text
                text="{approvalDetail>value}"
                wrapping="true"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </Panel>
  </VBox>
</core:FragmentDefinition>
