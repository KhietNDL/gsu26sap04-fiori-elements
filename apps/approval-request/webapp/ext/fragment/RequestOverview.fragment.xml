<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <VBox width="100%" class="sapUiSmallMarginTop approvalOverview">
    <Toolbar design="Transparent">
      <Title text="Request Information" level="H3"/>
      <ToolbarSpacer/>
    </Toolbar>

    <List
      width="100%"
      showSeparators="Inner"
      items="{approvalDetail>/requestInfoRows}"
      class="approvalInfoList">
      <CustomListItem>
        <HBox
          width="100%"
          renderType="Bare"
          class="approvalInfoRow">
          <Label
            width="10rem"
            text="{approvalDetail>label}"
            class="approvalInfoLabel"/>
          <ObjectStatus
            visible="{approvalDetail>isStatus}"
            text="{approvalDetail>value}"
            state="{approvalDetail>state}"/>
          <Text
            visible="{= !${approvalDetail>isStatus} }"
            text="{approvalDetail>value}"
            wrapping="true"/>
        </HBox>
      </CustomListItem>
    </List>
  </VBox>
</core:FragmentDefinition>
