<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <VBox width="100%" class="approvalInfoSection">
    <HBox alignItems="Center" wrap="Wrap" renderType="Bare" class="approvalInfoHeader">
      <Title text="Request Information" level="H2"/>
    </HBox>

    <VBox
      items="{approvalDetail>/requestInfoRows}"
      renderType="Bare"
      class="approvalInfoMatrix">
      <HBox alignItems="Start" renderType="Bare" class="approvalInfoField">
        <Label text="{= ${approvalDetail>label} + ':' }" class="approvalInfoLabel"/>
        <ObjectStatus
          visible="{approvalDetail>isStatus}"
          text="{approvalDetail>value}"
          state="{= ${approvalDetail>state} || 'None' }"
          class="approvalInfoValue"/>
        <Text
          visible="{= !${approvalDetail>isStatus} }"
          text="{approvalDetail>value}"
          tooltip="{approvalDetail>value}"
          wrapping="true"
          class="approvalInfoValue"/>
      </HBox>
    </VBox>

    <Panel
      expandable="true"
      expanded="false"
      headerText="Approval Comment Debug"
      class="sapUiSmallMarginTop"
      visible="{approvalDetail>/commentDebugVisible}">
      <Table
        width="100%"
        fixedLayout="false"
        showNoData="false"
        items="{approvalDetail>/commentDebugRows}">
        <columns>
          <Column width="16rem">
            <Text text="Field"/>
          </Column>
          <Column>
            <Text text="Value"/>
          </Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Text text="{approvalDetail>field}"/>
              <Text
                text="{approvalDetail>value}"
                wrapping="true"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </Panel>
  </VBox>
</core:FragmentDefinition>
