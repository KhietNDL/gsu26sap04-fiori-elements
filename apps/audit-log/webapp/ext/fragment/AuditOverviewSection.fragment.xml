<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <VBox width="100%" class="sapUiSmallMarginTop auditBusinessChange">
    <Title text="Audit Overview" level="H3" class="sapUiTinyMarginBottom"/>
    <Table
      width="100%"
      fixedLayout="false"
      class="auditOverviewTable"
      items="{auditDetail>/overviewRows}">
      <columns>
        <Column width="16rem"><Text text="Field"/></Column>
        <Column><Text text="Value"/></Column>
      </columns>
      <items>
        <ColumnListItem>
          <cells>
            <ObjectIdentifier title="{auditDetail>label}" class="auditFieldName"/>
            <ObjectStatus text="{auditDetail>value}" state="{= ${auditDetail>state} || 'None' }"/>
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>
</core:FragmentDefinition>
