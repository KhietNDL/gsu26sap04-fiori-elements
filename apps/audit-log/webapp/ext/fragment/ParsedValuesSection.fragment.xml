<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <VBox
    width="100%"
    class="sapUiSmallMarginTop auditRequestDetail auditBusinessChange">
    <Title
      text="{auditDetail>/changeTitle}"
      level="H3"
      class="sapUiTinyMarginBottom"/>
    <Panel
      expandable="true"
      expanded="true"
      headerText="Record Key"
      class="auditObjectKeyPanel sapUiSmallMarginBottom"
      visible="{auditDetail>/recordKeyVisible}">
      <Table
        width="100%"
        fixedLayout="true"
        showNoData="true"
        noDataText="No record key available"
        items="{auditDetail>/recordKeyRows}">
        <columns>
          <Column width="16rem"><Text text="Field"/></Column>
          <Column><Text text="Value"/></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Text text="{auditDetail>field}"/>
              <Text text="{auditDetail>value}" wrapping="true" class="auditLongText"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </Panel>
    <Table
      width="100%"
      class="auditChangeSapTable"
      fixedLayout="false"
      showNoData="true"
      noDataText="No parsed values available"
      items="{auditDetail>/changeRows}">
      <columns>
        <Column width="18rem">
          <Text text="Field"/>
        </Column>
        <Column visible="{auditDetail>/showOldColumn}">
          <Text text="Old Value"/>
        </Column>
        <Column visible="{auditDetail>/showNewColumn}">
          <Text text="New Value"/>
        </Column>
      </columns>
      <items>
        <ColumnListItem>
          <cells>
            <ObjectIdentifier
              title="{auditDetail>field}"
              class="auditFieldName"/>
            <Text
              text="{auditDetail>oldValue}"
              visible="{auditDetail>/showOldColumn}"
              wrapping="true"
              class="auditLongText"/>
            <Text
              text="{auditDetail>newValue}"
              visible="{auditDetail>/showNewColumn}"
              wrapping="true"
              class="auditLongText"/>
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>
</core:FragmentDefinition>
