<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Dialog
    contentWidth="70rem"
    contentHeight="17rem"
    stretchOnPhone="true"
    resizable="true"
    draggable="true"
    horizontalScrolling="false"
    class="auditBulkDialog">
    <customHeader>
      <Toolbar class="auditBulkDialogToolbar">
        <Title text="{auditBulk>/title}" level="H2"/>
        <ToolbarSpacer/>
        <Button
          icon="sap-icon://decline"
          type="Transparent"
          tooltip="Close"
          press=".onBulkAuditDialogClose"/>
      </Toolbar>
    </customHeader>
    <content>
      <VBox width="100%" class="auditBulkDialogContent">
        <FlexBox
          width="100%"
          wrap="Wrap"
          alignItems="Center"
          class="auditBulkDialogSummary sapUiSmallMarginBottom">
          <VBox class="auditBulkDialogSummaryCell auditBulkDialogAuditId">
            <Label text="Audit ID"/>
            <Text text="{auditBulk>/auditId}" wrapping="false"/>
          </VBox>
          <VBox class="auditBulkDialogSummaryCell">
            <Label text="Changed by"/>
            <Text text="{auditBulk>/changedBy}" wrapping="false"/>
          </VBox>
          <VBox class="auditBulkDialogSummaryCell">
            <Label text="Changed at"/>
            <Text text="{auditBulk>/changedAt}" wrapping="false"/>
          </VBox>
          <VBox class="auditBulkDialogSummaryCell auditBulkDialogDetails">
            <Label text="Details"/>
            <Text text="{auditBulk>/detailsText}" wrapping="false"/>
          </VBox>
          <ObjectStatus
            text="{auditBulk>/operationText}"
            icon="{auditBulk>/operationIcon}"
            state="{auditBulk>/operationState}"
            class="auditBulkOperationBadge">
            <customData>
              <core:CustomData key="action" value="{auditBulk>/operationKey}" writeToDom="true"/>
            </customData>
          </ObjectStatus>
        </FlexBox>

        <MessageStrip
          type="Information"
          showIcon="true"
          text="{auditBulk>/emptyText}"
          visible="{auditBulk>/emptyVisible}"/>

        <ScrollContainer
          width="100%"
          horizontal="true"
          vertical="false"
          focusable="true"
          visible="{= !${auditBulk>/emptyVisible} &amp;&amp; ${auditBulk>/tableRows}.length > 0 }"
          class="auditItemsScrollContainer">
          <Table
            width="{auditBulk>/tableWidth}"
            fixedLayout="true"
            sticky="ColumnHeaders"
            showNoData="false"
            alternateRowColors="true"
            columns="{path: 'auditBulk>/columns', templateShareable: false}"
            items="{path: 'auditBulk>/tableRows', templateShareable: false}"
            class="auditItemsSpreadsheet">
            <columns>
              <Column width="{auditBulk>width}">
                <Text text="{auditBulk>label}" tooltip="{auditBulk>label}" class="auditItemsHeaderText"/>
              </Column>
            </columns>
            <items>
              <ColumnListItem
                vAlign="Middle"
                cells="{path: 'auditBulk>cells', templateShareable: false}"
                class="auditItemsRow">
                <customData>
                  <core:CustomData key="action" value="{auditBulk>actionKey}" writeToDom="true"/>
                </customData>
                <cells>
                  <VBox renderType="Bare" class="auditSpreadsheetCell">
                    <ObjectStatus
                      text="{auditBulk>text}"
                      state="{auditBulk>state}"
                      visible="{= ${auditBulk>kind} === 'status' }"
                      class="auditSpreadsheetAction"/>
                    <Text
                      text="{auditBulk>text}"
                      tooltip="{auditBulk>tooltip}"
                      wrapping="true"
                      visible="{= ${auditBulk>kind} === 'key' }"
                      class="auditSpreadsheetKey"/>
                    <Text
                      text="{auditBulk>text}"
                      tooltip="{auditBulk>tooltip}"
                      wrapping="true"
                      visible="{= ${auditBulk>kind} !== 'status' &amp;&amp; ${auditBulk>kind} !== 'key' }"
                      class="auditSpreadsheetText"/>
                  </VBox>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </ScrollContainer>
      </VBox>
    </content>
    <endButton>
      <Button
        text="Close"
        type="Emphasized"
        press=".onBulkAuditDialogClose"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
