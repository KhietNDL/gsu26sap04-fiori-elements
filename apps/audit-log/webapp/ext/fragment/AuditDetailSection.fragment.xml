<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <VBox width="100%" class="auditApprovalDetail sapUiSmallMarginTop">
    <Panel headerText="Audit Information" class="auditApprovalPanel sapUiSmallMarginBottom">
      <Table width="100%" fixedLayout="false" items="{auditDetail>/overviewRows}">
        <columns>
          <Column width="16rem"><Text text="Field"/></Column>
          <Column><Text text="Value"/></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <ObjectIdentifier title="{auditDetail>label}" class="auditFieldName"/>
              <ObjectStatus text="{auditDetail>value}" state="{auditDetail>state}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </Panel>

    <MessageStrip
      type="Success"
      showIcon="true"
      text="{auditDetail>/rollbackMessage}"
      visible="{auditDetail>/rollbackMessageVisible}"
      class="sapUiSmallMarginBottom"/>

    <Title text="Audit Items" level="H3" class="sapUiTinyMarginBottom"/>
    <MessageStrip
      type="Information"
      showIcon="true"
      text="Review the audit item and open the detail before performing a rollback."
      class="sapUiSmallMarginBottom"/>
    <Text
      text="{auditItems>/itemSummary}"
      class="auditItemsSummary sapUiTinyMarginBottom"/>
    <List
      width="100%"
      showNoData="true"
      noDataText="No audit items available"
      items="{auditItems>/itemRows}">
      <CustomListItem>
        <VBox class="auditInlineItemCard">
          <FlexBox wrap="Wrap" class="auditInlineItemHeader">
            <VBox class="auditInlineItemCell"><Label text="Item Number"/><Text text="{auditItems>item}"/></VBox>
            <VBox class="auditInlineItemCell"><Label text="Action Type"/><ObjectStatus text="{auditItems>actionText}" state="{auditItems>actionState}"/></VBox>
            <VBox class="auditInlineItemCell"><Label text="Status"/><ObjectStatus text="{auditItems>statusText}" state="{auditItems>statusState}"/></VBox>
          </FlexBox>
          <Label text="Record Key" class="sapUiSmallMarginTop"/>
          <Text text="{auditItems>recordKey}" wrapping="true" class="auditItemRecordKeyText"/>
          <Table width="100%" fixedLayout="false" class="auditChangeSapTable sapUiSmallMarginTop" items="{auditItems>recordKeyRows}">
            <columns><Column width="16rem"><Text text="Field"/></Column><Column><Text text="Value"/></Column></columns>
            <items><ColumnListItem><cells><ObjectIdentifier title="{auditItems>field}" class="auditFieldName"/><Text text="{auditItems>value}" wrapping="true"/></cells></ColumnListItem></items>
          </Table>
          <MessageStrip type="Information" showIcon="true" text="{auditItems>message}" class="sapUiTinyMarginTop"/>
          <Table width="100%" fixedLayout="false" class="auditChangeSapTable sapUiSmallMarginTop" items="{auditItems>changeRows}">
            <columns><Column width="16rem"><Text text="Field"/></Column><Column visible="{auditItems>showOldColumn}"><Text text="{auditItems>oldColumnHeader}"/></Column><Column visible="{auditItems>showNewColumn}"><Text text="{auditItems>newColumnHeader}"/></Column></columns>
            <items><ColumnListItem><cells><ObjectIdentifier title="{auditItems>field}" class="auditFieldName"/><Text text="{auditItems>oldValue}" visible="{auditItems>showOldColumn}" wrapping="true"/><Text text="{auditItems>newValue}" visible="{auditItems>showNewColumn}" wrapping="true"/></cells></ColumnListItem></items>
          </Table>
        </VBox>
      </CustomListItem>
    </List>

    <Panel
      headerText="Raw JSON"
      expandable="true"
      expanded="false"
      class="auditRawJsonPanel sapUiSmallMarginTop">
      <VBox>
        <Label text="Record Key"/>
        <TextArea value="{auditDetail>/rawRecordKey}" editable="false" rows="2" growing="true"/>
        <Label text="Old Value" class="sapUiSmallMarginTop"/>
        <TextArea value="{auditDetail>/rawOldValue}" editable="false" rows="4" growing="true"/>
        <Label text="New Value" class="sapUiSmallMarginTop"/>
        <TextArea value="{auditDetail>/rawNewValue}" editable="false" rows="4" growing="true"/>
      </VBox>
    </Panel>
  </VBox>
</core:FragmentDefinition>
