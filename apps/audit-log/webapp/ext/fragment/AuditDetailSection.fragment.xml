<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <VBox width="100%" class="auditApprovalDetail sapUiSmallMarginTop">
    <Panel headerText="Full Audit Information" class="auditApprovalPanel sapUiSmallMarginBottom">
      <Table width="100%" fixedLayout="false" items="{auditDetail>/infoRows}">
        <columns>
          <Column width="16rem">
            <Text text="Field"/>
          </Column>
          <Column>
            <Text text="Value"/>
          </Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <ObjectIdentifier title="{auditDetail>label}" class="auditFieldName"/>
              <ObjectStatus
                text="{auditDetail>value}"
                state="{= ${auditDetail>state} || 'None' }"
                class="auditInfoValue"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </Panel>

    <MessageStrip
      type="Success"
      showIcon="true"
      text="{auditDetail>/rollbackMessage}"
      visible="{auditDetail>/rollbackMessageVisible}"
      class="sapUiSmallMarginBottom"/>

    <VBox visible="{= !${auditDetail>/bulkVisible} }" class="auditRequestDetail auditBusinessChange">
      <Title text="{auditDetail>/changeTitle}" level="H3" class="sapUiTinyMarginBottom"/>
      <core:HTML
        content="{auditDetail>/changeTableHtml}"
        sanitizeContent="false"
        visible="{= !!${auditDetail>/changeTableHtml} }"/>
      <MessageStrip
        type="Information"
        showIcon="true"
        text="No business field changes available"
        visible="{= !${auditDetail>/changeTableHtml} }"/>
    </VBox>

    <VBox visible="{auditDetail>/bulkVisible}" class="auditBulkItems sapUiSmallMarginTop">
      <Title text="Audit Items" level="H3" class="sapUiTinyMarginBottom"/>
      <MessageStrip
        type="Error"
        showIcon="true"
        text="{auditItems>/itemsErrorText}"
        visible="{auditItems>/itemsErrorVisible}"
        class="sapUiSmallMarginBottom"/>
      <Text text="{auditItems>/itemSummary}" class="auditItemsSummary sapUiTinyMarginBottom"/>
      <BusyIndicator
        visible="{auditItems>/itemsLoading}"
        class="sapUiSmallMarginTop"/>
      <core:HTML
        content="{auditItems>/bulkItemsHtml}"
        sanitizeContent="false"
        visible="{= !!${auditItems>/bulkItemsHtml} }"/>
      <MessageStrip
        type="Information"
        showIcon="true"
        text="No bulk audit item changes available"
        visible="{= !${auditItems>/bulkItemsHtml} &amp;&amp; !${auditItems>/itemsLoading} }"/>
    </VBox>
  </VBox>
</core:FragmentDefinition>
