<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <VBox width="100%" class="auditDetailRoot sapUiSmallMarginTop">
    <HBox
      width="100%"
      renderType="Bare"
      visible="{auditDetail>/rollbackMessageVisible}"
      class="auditRollbackNoticeWrap">
      <MessageStrip
        type="Success"
        showIcon="true"
        showCloseButton="false"
        text="{auditDetail>/rollbackMessage}"
        class="auditRollbackNotice"/>
    </HBox>

    <Panel
      width="100%"
      backgroundDesign="Solid"
      class="auditCardPanel auditInfoCardPanel">
      <content>
        <VBox width="100%" class="auditInfoSection">
      <HBox alignItems="Center" wrap="Wrap" renderType="Bare" class="auditInfoHeader">
        <VBox renderType="Bare" class="auditInfoHeading">
          <Title id="auditInformationTitle" text="{i18n>auditInfoTitle}" level="H2"/>
        </VBox>
        <ToolbarSpacer/>
        <ObjectStatus
          text="{auditDetail>/statusText}"
          state="{auditDetail>/statusState}"
          class="auditInfoHeaderStatus"/>
      </HBox>

      <VBox renderType="Bare" class="auditInfoMatrix">
        <HBox alignItems="Start" renderType="Bare" class="auditInfoField auditInfoTableName">
          <Label text="{i18n>auditInfoTableName}" class="auditInfoLabel"/>
          <Text text="{auditDetail>/tableName}" tooltip="{auditDetail>/tableName}" wrapping="true" class="auditInfoValue"/>
        </HBox>
        <HBox alignItems="Start" renderType="Bare" class="auditInfoField auditInfoOperation">
          <Label text="{i18n>auditInfoOperation}" class="auditInfoLabel"/>
          <ObjectStatus text="{auditDetail>/actionText}" state="{auditDetail>/actionState}" class="auditInfoValue"/>
        </HBox>
        <HBox alignItems="Start" renderType="Bare" class="auditInfoField">
          <Label text="{i18n>auditInfoAuditId}" class="auditInfoLabel"/>
          <HBox alignItems="Start" renderType="Bare" class="auditInfoCopyLine">
            <Text text="{auditDetail>/auditId}" tooltip="{auditDetail>/auditId}" wrapping="true" class="auditInfoValue auditInfoCode"/>
            <Button
              icon="sap-icon://copy"
              type="Transparent"
              tooltip="{i18n>auditInfoCopyAuditIdTooltip}"
              ariaLabelledBy="auditInfoCopyAuditIdLabel"
              press=".extension.ztbl.audit.ui.ext.controller.AuditLog.onCopyAuditIdPress"
              class="auditInfoCopyButton"/>
          </HBox>
          <core:InvisibleText id="auditInfoCopyAuditIdLabel" text="{i18n>auditInfoCopyAuditIdAriaLabel}"/>
        </HBox>
        <HBox alignItems="Start" renderType="Bare" class="auditInfoField">
          <Label text="{i18n>auditInfoChangedAt}" class="auditInfoLabel"/>
          <Text text="{auditDetail>/changedAt}" tooltip="{auditDetail>/changedAt}" wrapping="true" class="auditInfoValue"/>
        </HBox>
        <HBox
          alignItems="Start"
          renderType="Bare"
          visible="{auditDetail>/fieldNameVisible}"
          class="auditInfoField">
          <Label text="{i18n>auditInfoFieldName}" class="auditInfoLabel"/>
          <Text text="{auditDetail>/fieldName}" tooltip="{auditDetail>/fieldName}" wrapping="true" class="auditInfoValue"/>
        </HBox>
        <HBox alignItems="Start" renderType="Bare" class="auditInfoField">
          <Label text="{i18n>auditInfoChangedBy}" class="auditInfoLabel"/>
          <Text text="{auditDetail>/changedBy}" tooltip="{auditDetail>/changedBy}" wrapping="true" class="auditInfoValue"/>
        </HBox>
        <HBox alignItems="Start" renderType="Bare" class="auditInfoField auditInfoFieldWide">
          <Label text="{auditDetail>/linkedAuditLabel}" class="auditInfoLabel"/>
          <Link
            text="{auditDetail>/linkedAuditId}"
            tooltip="{auditDetail>/linkedAuditId}"
            visible="{= ${auditDetail>/linkedAuditId} !== '—' }"
            press=".extension.ztbl.audit.ui.ext.controller.AuditLog.onAuditLinkedIdPress"
            class="auditInfoValue auditInfoCode auditLinkedId"/>
          <Text
            text="{auditDetail>/linkedAuditId}"
            tooltip="{auditDetail>/linkedAuditId}"
            visible="{= ${auditDetail>/linkedAuditId} === '—' }"
            wrapping="true"
            class="auditInfoValue auditInfoCode"/>
        </HBox>
      </VBox>
        </VBox>
      </content>
    </Panel>

    <Panel
      width="100%"
      backgroundDesign="Solid"
      class="auditCardPanel auditItemsCardPanel">
      <content>
        <VBox width="100%" class="auditItemsCard">
      <Toolbar design="Transparent" class="auditItemsToolbar">
        <VBox renderType="Bare">
          <Title id="auditItemsTitle" text="{i18n>auditItemsTitle}" level="H2"/>
          <Text text="{i18n>auditItemsDescription}" class="auditCardSubtitle"/>
        </VBox>
        <ToolbarSpacer/>
        <ObjectStatus text="{auditItems>/itemSummary}" state="Information" class="auditItemsSummaryBadge"/>
      </Toolbar>

      <MessageStrip
        type="Error"
        showIcon="true"
        text="{auditItems>/itemsErrorText}"
        visible="{auditItems>/itemsErrorVisible}"
        class="sapUiSmallMarginBottom"/>
      <BusyIndicator
        visible="{auditItems>/itemsLoading}"
        text="{i18n>auditItemsLoading}"
        class="sapUiSmallMargin"/>

      <ScrollContainer
        width="100%"
        horizontal="true"
        vertical="false"
        focusable="true"
        visible="{= !${auditItems>/itemsLoading} &amp;&amp; ${auditItems>/tableRows}.length > 0 }"
        class="auditItemsScrollContainer">
        <Table
          width="{auditItems>/tableWidth}"
          fixedLayout="true"
          sticky="ColumnHeaders"
          showNoData="false"
          alternateRowColors="true"
          ariaLabelledBy="auditItemsTitle"
          columns="{path: 'auditItems>/columns', templateShareable: false}"
          items="{path: 'auditItems>/tableRows', templateShareable: false}"
          class="auditItemsSpreadsheet">
          <columns>
            <Column width="{auditItems>width}">
              <Text text="{auditItems>label}" tooltip="{auditItems>label}" class="auditItemsHeaderText"/>
            </Column>
          </columns>
          <items>
            <ColumnListItem
              vAlign="Middle"
              cells="{path: 'auditItems>cells', templateShareable: false}"
              class="auditItemsRow">
              <customData>
                <core:CustomData key="action" value="{auditItems>actionKey}" writeToDom="true"/>
              </customData>
              <cells>
                <VBox renderType="Bare" class="auditSpreadsheetCell">
                  <ObjectStatus
                    text="{auditItems>text}"
                    state="{auditItems>state}"
                    visible="{= ${auditItems>kind} === 'status' }"
                    class="auditSpreadsheetAction"/>
                  <Text
                    text="{auditItems>text}"
                    tooltip="{auditItems>tooltip}"
                    wrapping="true"
                    visible="{= ${auditItems>kind} === 'key' }"
                    class="auditSpreadsheetKey"/>
                  <Text
                    text="{auditItems>text}"
                    tooltip="{auditItems>tooltip}"
                    wrapping="true"
                    visible="{= ${auditItems>kind} !== 'status' &amp;&amp; ${auditItems>kind} !== 'key' }"
                    class="auditSpreadsheetText"/>
                </VBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </ScrollContainer>

      <MessageStrip
        type="Information"
        showIcon="true"
        text="{i18n>auditItemsEmpty}"
        visible="{= !${auditItems>/itemsLoading} &amp;&amp; !${auditItems>/itemsErrorVisible} &amp;&amp; ${auditItems>/tableRows}.length === 0 }"/>
      <MessageStrip
        type="Information"
        showIcon="true"
        text="{auditItems>/messageText}"
        visible="{auditItems>/messageVisible}"
        class="sapUiSmallMarginTop"/>
        </VBox>
      </content>
    </Panel>
  </VBox>
</core:FragmentDefinition>
