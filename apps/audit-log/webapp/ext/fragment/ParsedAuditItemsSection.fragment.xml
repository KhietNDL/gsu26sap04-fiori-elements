<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <VBox width="100%" class="sapUiSmallMarginTop auditBusinessChange">
    <Title text="Audit Items" level="H3" class="sapUiTinyMarginBottom"/>
    <Table
      width="100%"
      class="auditChangeSapTable"
      fixedLayout="false"
      showNoData="true"
      noDataText="No audit items available"
      items="{auditItems>/rows}">
      <columns>
        <Column width="5rem"><Text text="Item"/></Column>
        <Column width="8rem"><Text text="Action"/></Column>
        <Column width="16rem"><Text text="Record Key"/></Column>
        <Column width="16rem"><Text text="Field"/></Column>
        <Column><Text text="Old Value"/></Column>
        <Column><Text text="New Value"/></Column>
      </columns>
      <items>
        <ColumnListItem>
          <cells>
            <Text text="{auditItems>item}"/>
            <ObjectStatus text="{auditItems>actionText}" state="{= ${auditItems>actionState} || 'None' }"/>
            <Text text="{auditItems>recordKey}" wrapping="true" class="auditLongText"/>
            <Text text="{auditItems>field}" class="auditFieldName"/>
            <Text text="{auditItems>oldValue}" wrapping="true" class="auditLongText"/>
            <Text text="{auditItems>newValue}" wrapping="true" class="auditLongText"/>
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>
</core:FragmentDefinition>
