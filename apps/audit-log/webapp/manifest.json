{
  "_version": "1.59.0",
  "sap.app": {
    "id": "ztbl.audit.ui",
    "type": "application",
    "title": "{{auditAppTitle}}",
    "description": "{{auditAppDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zsb_tbl_config/srvd/sap/zsd_tbl_config/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml",
          "annotations": [
            "auditLogAnnotation"
          ]
        }
      },
      "auditLogAnnotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/audit-log.xml",
        "settings": {
          "localUri": "annotations/audit-log.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZAuditLog-display": {
          "semanticObject": "ZAuditLog",
          "action": "display",
          "title": "{{auditLogFlpTitle}}",
          "subtitle": "{{auditLogFlpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "icons": {
      "icon": "sap-icon://activity-items"
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.108.33",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.codeeditor": {},
        "sap.fe.templates": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/audit.css"
        }
      ]
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "ztbl.audit.ui.ext.controller.AuditLog"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "ztbl.audit.ui.ext.controller.AuditLog"
          }
        }
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ztbl.audit.ui.i18n.i18n"
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "AuditLogList",
          "target": "AuditLogList"
        },
        {
          "pattern": "AuditLog({key}):?query:",
          "name": "AuditLogObjectPage",
          "target": "AuditLogObjectPage"
        }
      ],
      "targets": {
        "AuditLogList": {
          "type": "Component",
          "id": "AuditLogList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/AuditLog",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "AuditLog": {
                  "detail": {
                    "route": "AuditLogObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "columns": {
                    "DataField::RecordKey": {
                      "availability": "Hidden"
                    },
                    "DataField::FieldName": {
                      "availability": "Hidden"
                    },
                    "DataField::ActionType": {
                      "availability": "Hidden"
                    },
                    "DataField::OldValue": {
                      "availability": "Hidden"
                    },
                    "DataField::NewValue": {
                      "availability": "Hidden"
                    },
                    "DataField::RollbackAuditId": {
                      "availability": "Hidden"
                    },
                    "OperationColumn": {
                      "header": "Operation",
                      "template": "ztbl.audit.ui.ext.fragment.OperationColumn",
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::TableName"
                      },
                      "width": "10rem",
                      "properties": [
                        "ActionType",
                        "RecordKey"
                      ]
                    }
                  },
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "AuditLogObjectPage": {
          "type": "Component",
          "id": "AuditLogObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/AuditLog",
              "editableHeaderContent": false,
              "content": {
                "body": {
                  "sections": {
                    "AuditDetailSection": {
                      "title": "Audit Details",
                      "template": "ztbl.audit.ui.ext.fragment.AuditDetailSection"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "ztbl.audit.ui"
  }
}
